# Optional Flask environment settings
FLASK_DEBUG=0

AGENT_MODE=rules
QWEN_MODEL=qwen-turbo
DASHSCOPE_API_KEY=
QWEN_FREE_ONLY_CONFIRMED=false
FLASK_SECRET_KEY=replace-with-a-random-secret

# Choose a model only after confirming account-specific free quota and stop-on-exhaustion.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Open-Meteo only: auto retries TLS EOF directly; system always uses system proxy; direct bypasses proxies.
WEATHER_PROXY_MODE=auto
